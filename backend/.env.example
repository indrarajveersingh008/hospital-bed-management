# Application settings
APP_NAME="Hospital Bed Availability & Management System"
DEBUG=true

# Database Settings
# For MySQL: mysql+pymysql://user:pass@host:port/dbname
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hospital_bed_system
DATABASE_REPLICA_URL=mysql+pymysql://root:password@localhost:3306/hospital_bed_system_replica

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Security & JWT Settings
JWT_SECRET_KEY=supersecretjwtkeythatshouldbechangedinproduction1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MFA Settings
MFA_ENCRYPTION_KEY=supersecretmfaencryptionkey1234567890abcdef

# Secrets Manager (NEW)
# Set to 'vault' or 'aws' to retrieve secrets from Vault or AWS Secrets Manager
SECRETS_PROVIDER=local
SECRETS_VAULT_URL=http://localhost:8200
SECRETS_VAULT_TOKEN=
SECRETS_AWS_REGION=us-east-1
